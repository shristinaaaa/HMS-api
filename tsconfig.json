
{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./build",

    "module": "Node16",
    "moduleResolution": "Node16",

    "target": "ES2020",
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
